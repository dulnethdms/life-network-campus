<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect private files and directories from direct access
    RewriteRule ^(\.env|\.git|app|config|database|routes|storage|tests)(/.*)?$ - [F,L,NC]

    # Rewrite root to public/
    RewriteRule ^$ public/ [L]

    # Rewrite all other requests to public/ if not already starting with public/
    RewriteCond %{REQUEST_URI} !^/life-network-campus/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
